# Địa chỉ gốc của API backend, KHÔNG kèm hậu tố /api — apiClient tự thêm khi dựng URL.
#
# 5002 là cổng mà src/EduQuiz.Api/Properties/launchSettings.json của backend đang dùng.
# Đổi cổng bên đó thì phải đổi cả ở đây, và thêm origin mới vào Cors:AllowedOrigins
# trong appsettings.Development.json, nếu không trình duyệt chặn ngay từ preflight.
#
# Sao chép file này thành .env rồi chỉnh cho đúng môi trường của bạn.
VITE_API_BASE_URL=http://localhost:5002
